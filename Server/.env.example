# Copy to .env and adjust. Never commit real secrets.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=bookstore
PORT=5050

# Origins allowed to call the API with cookies (comma separated). Needed only if the
# React apps call the server directly instead of through the Vite proxy.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Set to true when the site is served over HTTPS so the session cookie is HTTPS-only.
COOKIE_SECURE=false

# Optional: only allow book links from these hosts (comma separated). Empty = any http(s) host.
ALLOWED_URL_HOSTS=

# Used only by `npm run create-admin` (pass them on the command line instead of saving them):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
